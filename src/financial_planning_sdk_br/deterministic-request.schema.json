{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finplanbr:schema:deterministic-cashflow-ledger-request:0.1.0-draft.1",
  "title": "FinPlanBR deterministic cashflow ledger request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "calculation_id",
    "valuation_date",
    "base_currency",
    "use_context",
    "discount_factors",
    "cashflows",
    "accounts",
    "events"
  ],
  "properties": {
    "contract_version": {"const": "0.1.0-draft.1"},
    "calculation_id": {"$ref": "#/$defs/identifier"},
    "valuation_date": {"$ref": "#/$defs/civilDate"},
    "base_currency": {"const": "BRL"},
    "use_context": {"$ref": "#/$defs/useContext"},
    "discount_factors": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/discountFactor"}
    },
    "cashflows": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/cashflow"}
    },
    "accounts": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/account"}
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/postingEvent"},
          {"$ref": "#/$defs/transferEvent"},
          {"$ref": "#/$defs/returnEvent"}
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$(?![\\s\\S])"
    },
    "civilDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
    },
    "discountFactorDecimal": {
      "title": "Discount factor decimal with a 38-significant-digit semantic budget",
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$(?![\\s\\S])",
      "maxLength": 40,
      "x-significant-digit-budget": 38
    },
    "returnRateDecimal": {
      "title": "Return rate decimal with a separate 38-significant-digit semantic budget",
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$(?![\\s\\S])",
      "maxLength": 40,
      "x-significant-digit-budget": 38
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "value"],
      "properties": {
        "currency": {"const": "BRL"},
        "value": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{2}$(?![\\s\\S])",
          "maxLength": 40,
          "x-significant-digit-budget": 38
        }
      }
    },
    "useContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "client_specific", "recommendation_enabled", "execution_enabled"],
      "properties": {
        "purpose": {"enum": ["education", "scientific_evaluation", "software_testing"]},
        "client_specific": {"const": false},
        "recommendation_enabled": {"const": false},
        "execution_enabled": {"const": false}
      }
    },
    "discountFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "factor"],
      "properties": {
        "date": {"$ref": "#/$defs/civilDate"},
        "factor": {"$ref": "#/$defs/discountFactorDecimal"}
      }
    },
    "cashflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cashflow_id", "claim_id", "event_date", "amount"],
      "properties": {
        "cashflow_id": {"$ref": "#/$defs/identifier"},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "event_date": {"$ref": "#/$defs/civilDate"},
        "amount": {"$ref": "#/$defs/money"}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "opening_balance", "return_basis"],
      "properties": {
        "account_id": {"$ref": "#/$defs/identifier"},
        "opening_balance": {"$ref": "#/$defs/money"},
        "return_basis": {"enum": ["none", "price_return", "total_return"]}
      }
    },
    "postingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "event_id", "effective_date", "sequence", "account_id", "category", "claim_id", "amount"],
      "properties": {
        "event_type": {"const": "posting"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "effective_date": {"$ref": "#/$defs/civilDate"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "account_id": {"$ref": "#/$defs/identifier"},
        "category": {"enum": ["contribution", "withdrawal", "income", "gain", "fee", "tax", "adjustment"]},
        "claim_id": {"$ref": "#/$defs/identifier"},
        "amount": {"$ref": "#/$defs/money"}
      }
    },
    "transferEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "event_id", "effective_date", "sequence", "from_account_id", "to_account_id", "economic_source_id", "amount"],
      "properties": {
        "event_type": {"const": "transfer"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "effective_date": {"$ref": "#/$defs/civilDate"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "from_account_id": {"$ref": "#/$defs/identifier"},
        "to_account_id": {"$ref": "#/$defs/identifier"},
        "economic_source_id": {"$ref": "#/$defs/identifier"},
        "amount": {"$ref": "#/$defs/money"}
      }
    },
    "returnEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "event_id", "effective_date", "sequence", "account_id", "return_basis", "rate", "cash_distribution"],
      "properties": {
        "event_type": {"const": "return"},
        "event_id": {"$ref": "#/$defs/identifier"},
        "effective_date": {"$ref": "#/$defs/civilDate"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "account_id": {"$ref": "#/$defs/identifier"},
        "return_basis": {"enum": ["price_return", "total_return"]},
        "rate": {"$ref": "#/$defs/returnRateDecimal"},
        "cash_distribution": {"$ref": "#/$defs/money"}
      }
    }
  }
}
