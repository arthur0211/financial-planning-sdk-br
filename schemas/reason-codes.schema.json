    "POLICY_KNOWLEDGE_GAP": {"category": "policy", "default_severity": "error", "default_status": "indeterminate", "owner": "policy", "remediation_id": "provide-point-in-time-policy"},
    "RETROACTIVITY_UNMODELED": {"category": "policy", "default_severity": "error", "default_status": "indeterminate", "owner": "policy", "remediation_id": "model-retroactivity"},
    "DATA_SNAPSHOT_MISSING": {"category": "data", "default_severity": "error", "default_status": "indeterminate", "owner": "data", "remediation_id": "provide-data-snapshot"},
    "DATA_SCHEMA_MISMATCH": {"category": "data", "default_severity": "error", "default_status": "rejected", "owner": "data", "remediation_id": "align-data-schema"},
