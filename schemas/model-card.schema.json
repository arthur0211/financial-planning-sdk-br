{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financial-planning-sdk-br:schema:model-card:0.0.0",
  "title": "ModelCard",
  "description": "Machine-checkable model-risk record. Validity does not establish model approval or fitness for use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "model_id",
    "specification_version",
    "artifact_status",
    "lifecycle_status",
    "model_use_status",
    "owner",
    "independent_reviewer",
    "intended_purpose",
    "prohibited_uses",
    "supported_population_and_cases",
    "equations_and_units",
    "valuation_context",
    "information_set_requirements",
    "data_and_parameter_versions",
    "policy_dependencies",
    "assumptions",
    "known_limitations",
    "validation_evidence",
    "benchmark_protocol",
    "uncertainty_decomposition",
    "failure_modes",
    "fallback",
    "approved_at",
    "review_expires_at"
  ],
  "properties": {
    "contract_version": {
      "const": "0.0.0"
    },
    "model_id": {
      "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
    },
    "specification_version": {
      "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/version"
    },
    "artifact_status": {
      "enum": ["draft", "approved"]
    },
    "test_only": {
      "type": "boolean"
    },
    "lifecycle_status": {
      "enum": [
        "proposed",
        "experimental",
        "research",
        "beta",
        "stable",
        "deprecated",
        "retired"
      ]
    },
    "model_use_status": {
      "enum": [
        "research_only",
        "reviewed_non_production",
        "approved_for_declared_use",
        "blocked"
      ]
    },
    "owner": {
      "oneOf": [
        {
          "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "independent_reviewer": {
      "oneOf": [
        {
          "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "intended_purpose": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "prohibited_uses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "supported_population_and_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "equations_and_units": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "equation_ref",
          "input_units",
          "output_unit"
        ],
        "properties": {
          "equation_ref": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          },
          "input_units": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
            }
          },
          "output_unit": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          }
        }
      }
    },
    "valuation_context": {
      "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/valuation_context"
    },
    "information_set_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
      }
    },
    "data_and_parameter_versions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/artifact_reference"
      }
    },
    "policy_dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/artifact_reference"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "epistemic_status"
        ],
        "properties": {
          "assumption_id": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "epistemic_status": {
            "enum": [
              "evidence",
              "inference",
              "hypothesis",
              "decision"
            ]
          }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "validation_evidence": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "status",
          "artifact_ref"
        ],
        "properties": {
          "evidence_id": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          },
          "status": {
            "enum": [
              "not_performed",
              "planned",
              "passed",
              "failed"
            ]
          },
          "artifact_ref": {
            "oneOf": [
              {
                "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/artifact_reference"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
          },
          "evaluated_at": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"
          },
          "evidence_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "benchmark_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "status",
        "preregistered_artifact"
      ],
      "properties": {
        "protocol_id": {
          "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
        },
        "status": {
          "enum": [
            "not_defined",
            "draft",
            "preregistered",
            "completed",
            "failed"
          ]
        },
        "preregistered_artifact": {
          "oneOf": [
            {
              "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/artifact_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "preregistered_artifact_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"
        },
        "preregistered_at": {
          "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"
        },
        "evidence_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "comparators": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["comparator_id", "comparator_kind", "artifact_ref", "artifact_path", "evaluated_at", "evidence_summary"],
            "properties": {
              "comparator_id": {"$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"},
              "comparator_kind": {"enum": ["analytic_closed_form", "independent_implementation", "external_software"]},
              "artifact_ref": {"$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/artifact_fingerprint"},
              "artifact_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"},
              "evaluated_at": {"$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"},
              "evidence_summary": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
          }
        }
      }
    },
    "uncertainty_decomposition": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "path_randomness",
          "monte_carlo_sampling_error",
          "parameter_uncertainty",
          "model_specification_uncertainty",
          "legal_policy_uncertainty",
          "data_quality_and_revision_uncertainty",
          "behavioral_and_preference_uncertainty"
        ]
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_mode_id",
          "detection",
          "result_status"
        ],
        "properties": {
          "failure_mode_id": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          },
          "detection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "result_status": {
            "enum": [
              "computed_with_warnings",
              "indeterminate",
              "rejected"
            ]
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fallback_id",
        "enabled",
        "effect"
      ],
      "properties": {
        "fallback_id": {
          "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
        },
        "enabled": {
          "type": "boolean"
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "approved_at": {
      "oneOf": [
        {"$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"},
        {"type": "null"}
      ]
    },
    "review_expires_at": {
      "oneOf": [
        {"$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"},
        {"type": "null"}
      ]
    },
    "approval_attestation": {
      "oneOf": [
        {"$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/approval_attestation"},
        {"type": "null"}
      ]
    }
  },
  "x-semantic-validators": ["MODEL_APPROVAL_INTEGRITY_FAILED"],
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"properties": {"owner": {"type": "null"}}, "required": ["owner"]},
          {"properties": {"independent_reviewer": {"type": "null"}}, "required": ["independent_reviewer"]},
          {"properties": {"review_expires_at": {"type": "null"}}, "required": ["review_expires_at"]}
        ]
      },
      "then": {
        "properties": {
          "model_use_status": {
            "const": "research_only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_status": {"const": "approved"}
        },
        "required": ["artifact_status"]
      },
      "then": {
        "required": ["approval_attestation"],
        "properties": {
          "model_use_status": {"const": "approved_for_declared_use"},
          "lifecycle_status": {
            "enum": [
              "beta",
              "stable"
            ]
          },
          "owner": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          },
          "independent_reviewer": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/identifier"
          },
          "approved_at": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"
          },
          "review_expires_at": {
            "$ref": "urn:financial-planning-sdk-br:schema:common:0.0.0#/$defs/rfc3339_date_time"
          },
          "validation_evidence": {
            "minItems": 1,
            "items": {
              "required": ["evidence_id", "status", "artifact_ref", "artifact_path", "evaluated_at", "evidence_summary"],
              "properties": {"status": {"const": "passed"}}
            }
          },
          "benchmark_protocol": {
            "required": ["preregistered_artifact_path", "preregistered_at", "evidence_summary", "comparators"],
            "properties": {
              "status": {"const": "completed"},
              "comparators": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"test_only": {"const": true}},
        "required": ["test_only"]
      },
      "then": {
        "properties": {
          "artifact_status": {"const": "draft"},
          "model_use_status": {"const": "research_only"},
          "lifecycle_status": {"enum": ["proposed", "experimental", "research"]},
          "approval_attestation": {"type": "null"},
          "approved_at": {"type": "null"},
          "review_expires_at": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"model_use_status": {"const": "approved_for_declared_use"}}, "required": ["model_use_status"]},
      "then": {"properties": {"artifact_status": {"const": "approved"}}}
    },
    {
      "if": {
        "properties": {
          "lifecycle_status": {
            "const": "retired"
          }
        },
        "required": [
          "lifecycle_status"
        ]
      },
      "then": {
        "properties": {
          "model_use_status": {
            "const": "blocked"
          }
        }
      }
    }
  ]
}
